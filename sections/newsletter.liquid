<section class="ava-section ava-bg-dark ava-news ava-on-dark">
  <div class="ava-news__inner">
    {%- if section.settings.heading != blank -%}<h2 class="ava-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="ava-lead ava-news__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    {%- form 'customer', class: 'ava-news__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input class="ava-input" type="email" name="contact[email]" required
             placeholder="{{ section.settings.placeholder | default: 'Email address' }}"
             aria-label="{{ section.settings.placeholder | default: 'Email address' }}">
      <button type="submit" class="ava-btn ava-btn--light ava-news__btn">{{ section.settings.button_label | default: 'Subscribe' }}</button>
    {%- endform -%}
    {%- if form.posted_successfully? -%}
      <p class="ava-body ava-news__confirm">{{ 'general.newsletter.confirmation' | t | default: 'Thanks for subscribing.' }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the movement." },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}

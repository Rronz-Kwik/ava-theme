{{ 'confirm-shipping-address.css' | asset_url | stylesheet_tag }}
{%- if customer -%}
  <script src="{{ 'confirm-shipping-address.js' | asset_url }}" defer></script>
{%- endif -%}

{%- liquid
  assign heading = section.settings.heading | escape
  if heading == blank
    assign heading = 'confirm_shipping.heading' | t
  endif

  assign button_label = section.settings.button_label | escape
  if button_label == blank
    assign button_label = 'confirm_shipping.submit' | t
  endif

  assign proxy_path = section.settings.proxy_path | strip
  if proxy_path == blank
    assign proxy_path = '/apps/ava-china-address'
  endif

  if section.settings.success_redirect != blank
    capture success_url
      render 'localized-url', url: section.settings.success_redirect
    endcapture
  else
    assign success_url = routes.account_url
  endif

  assign login_url = routes.account_login_url
  assign form_id = 'ConfirmShipping-' | append: section.id

  assign prefill = nil
  if customer and customer.default_address.country_code == 'CN'
    assign prefill = customer.default_address
  endif
-%}
<section class="ava-section ava-bg-panel ava-csa">
  <div class="ava-container ava-container--narrow">
    <div class="ava-csa__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ava-eyebrow ava-eyebrow--blue">{{ section.settings.eyebrow | escape }}</p>
      {%- else -%}
        <p class="ava-eyebrow ava-eyebrow--blue">{{ 'confirm_shipping.eyebrow' | t }}</p>
      {%- endif -%}
      <h1 class="ava-h1 ava-h1--page-lg">{{ heading }}</h1>
      {%- if section.settings.intro != blank -%}
        <div class="ava-lead ava-csa__intro">{{ section.settings.intro }}</div>
      {%- else -%}
        <p class="ava-lead ava-csa__intro">{{ 'confirm_shipping.intro' | t }}</p>
      {%- endif -%}
    </div>

    {%- if customer == blank -%}
      <div class="ava-csa__card ava-csa__prompt">
        <p class="ava-body">{{ 'confirm_shipping.login_prompt' | t }}</p>
        <a class="ava-btn ava-mt-lg" href="{{ login_url }}">{{ 'confirm_shipping.login_link' | t }}</a>
      </div>
    {%- else -%}
      <form
        id="{{ form_id }}"
        class="ava-csa__card"
        data-csa-form
        data-proxy-path="{{ proxy_path | escape }}"
        data-locale="{{ request.locale.iso_code }}"
        data-login-url="{{ login_url | escape }}"
        data-success-url="{{ success_url | escape }}"
        data-prefill-province-code="{{ prefill.province_code | escape }}"
        data-prefill-city="{{ prefill.city | escape }}"
        data-default-address-id="{{ prefill.id | escape }}"
        data-district-list="{{ customer.metafields.apex.districtList.value | escape }}"
        method="post"
        novalidate
      >
        <script type="application/json" data-csa-messages>
          {
            "saving": {{ 'confirm_shipping.saving' | t | json }},
            "confirmed": {{ 'confirm_shipping.confirmed' | t | json }},
            "saved": {{ 'confirm_shipping.saved' | t | json }},
            "sessionExpired": {{ 'confirm_shipping.session_expired' | t | json }},
            "errorSummary": {{ 'confirm_shipping.error_summary' | t | json }},
            "genericError": {{ 'confirm_shipping.error_generic' | t | json }},
            "networkError": {{ 'confirm_shipping.error_network' | t | json }},
            "selectProvince": {{ 'enrollment.shipping.select_province' | t | json }},
            "selectCity": {{ 'enrollment.shipping.select_city' | t | json }},
            "selectProvinceFirst": {{ 'enrollment.shipping.select_province_first' | t | json }},
            "selectDistrict": {{ 'enrollment.shipping.select_district' | t | json }},
            "selectCityFirst": {{ 'enrollment.shipping.select_city_first' | t | json }},
            "loading": {{ 'enrollment.shipping.checking' | t | json }},
            "loadFailed": {{ 'enrollment.shipping.load_failed' | t | json }}
          }
        </script>

        <p class="ava-body-sm ava-csa__required-note">
          <span class="ava-csa__req" aria-hidden="true">*</span>
          {{ 'confirm_shipping.required_note' | t }}
        </p>

        <div class="ava-csa__grid">
          <div class="ava-csa__field ava-csa__field--full">
            <span class="ava-csa__label">{{ 'confirm_shipping.country' | t }}</span>
            <p class="ava-csa__static" id="{{ form_id }}-country">
              <span class="ava-csa__static-icon" aria-hidden="true">{% render 'ava-icon', icon: 'truck', size: 20 %}</span>
              {{ 'confirm_shipping.country_name' | t }}
              <span class="ava-csa__static-code">CN</span>
            </p>
          </div>

          <div class="ava-csa__field">
            <label class="ava-csa__label" for="{{ form_id }}-first-name">
              {{ 'confirm_shipping.first_name' | t }} <span class="ava-csa__req" aria-hidden="true">*</span>
            </label>
            <input
              class="ava-csa__input"
              id="{{ form_id }}-first-name"
              name="firstName"
              type="text"
              value="{{ prefill.first_name | escape }}"
              autocomplete="shipping given-name"
              maxlength="255"
              required
              aria-describedby="{{ form_id }}-first-name-error"
            >
            <p class="ava-csa__error" id="{{ form_id }}-first-name-error" data-error-for="firstName" aria-live="polite" hidden></p>
          </div>

          <div class="ava-csa__field">
            <label class="ava-csa__label" for="{{ form_id }}-last-name">
              {{ 'confirm_shipping.last_name' | t }} <span class="ava-csa__req" aria-hidden="true">*</span>
            </label>
            <input
              class="ava-csa__input"
              id="{{ form_id }}-last-name"
              name="lastName"
              type="text"
              value="{{ prefill.last_name | escape }}"
              autocomplete="shipping family-name"
              maxlength="255"
              required
              aria-describedby="{{ form_id }}-last-name-error"
            >
            <p class="ava-csa__error" id="{{ form_id }}-last-name-error" data-error-for="lastName" aria-live="polite" hidden></p>
          </div>

          <div class="ava-csa__field">
            <label class="ava-csa__label" for="{{ form_id }}-phone">
              {{ 'confirm_shipping.phone' | t }} <span class="ava-csa__req" aria-hidden="true">*</span>
            </label>
            <input
              class="ava-csa__input"
              id="{{ form_id }}-phone"
              name="phone"
              type="tel"
              value="{{ prefill.phone | escape }}"
              autocomplete="shipping tel"
              inputmode="tel"
              maxlength="30"
              required
              aria-describedby="{{ form_id }}-phone-error"
            >
            <p class="ava-csa__error" id="{{ form_id }}-phone-error" data-error-for="phone" aria-live="polite" hidden></p>
          </div>

          <div class="ava-csa__field">
            <label class="ava-csa__label" for="{{ form_id }}-zip">
              {{ 'confirm_shipping.zip' | t }} <span class="ava-csa__req" aria-hidden="true">*</span>
            </label>
            <input
              class="ava-csa__input"
              id="{{ form_id }}-zip"
              name="zip"
              type="text"
              value="{{ prefill.zip | escape }}"
              autocomplete="shipping postal-code"
              inputmode="numeric"
              maxlength="20"
              required
              aria-describedby="{{ form_id }}-zip-error"
            >
            <p class="ava-csa__error" id="{{ form_id }}-zip-error" data-error-for="zip" aria-live="polite" hidden></p>
          </div>

          <div class="ava-csa__field ava-csa__field--full">
            <label class="ava-csa__label" for="{{ form_id }}-address1">
              {{ 'confirm_shipping.address1' | t }} <span class="ava-csa__req" aria-hidden="true">*</span>
            </label>
            <input
              class="ava-csa__input"
              id="{{ form_id }}-address1"
              name="address1"
              type="text"
              value="{{ prefill.address1 | escape }}"
              autocomplete="shipping address-line1"
              maxlength="255"
              required
              aria-describedby="{{ form_id }}-address1-error"
            >
            <p class="ava-csa__error" id="{{ form_id }}-address1-error" data-error-for="address1" aria-live="polite" hidden></p>
          </div>

          <div class="ava-csa__field ava-csa__field--full">
            <label class="ava-csa__label" for="{{ form_id }}-address2">
              {{ 'confirm_shipping.address2' | t }}
            </label>
            <input
              class="ava-csa__input"
              id="{{ form_id }}-address2"
              name="address2"
              type="text"
              value="{{ prefill.address2 | escape }}"
              autocomplete="shipping address-line2"
              maxlength="255"
              aria-describedby="{{ form_id }}-address2-error"
            >
            <p class="ava-csa__error" id="{{ form_id }}-address2-error" data-error-for="address2" aria-live="polite" hidden></p>
          </div>

          <div class="ava-csa__row ava-csa__row--three ava-csa__field--full">
            <div class="ava-csa__field">
              <label class="ava-csa__label" for="{{ form_id }}-province">
                {{ 'confirm_shipping.province' | t }} <span class="ava-csa__req" aria-hidden="true">*</span>
              </label>
              <select
                class="ava-csa__input ava-csa__select"
                id="{{ form_id }}-province"
                name="province"
                autocomplete="shipping address-level1"
                required
                data-geo-province
                disabled
                aria-describedby="{{ form_id }}-province-error"
              >
                <option value="">{{ 'enrollment.shipping.select_province' | t }}</option>
              </select>
              <p class="ava-csa__error" id="{{ form_id }}-province-error" data-error-for="province" aria-live="polite" hidden></p>
            </div>

            <div class="ava-csa__field">
              <label class="ava-csa__label" for="{{ form_id }}-city">
                {{ 'confirm_shipping.city' | t }} <span class="ava-csa__req" aria-hidden="true">*</span>
              </label>
              <select
                class="ava-csa__input ava-csa__select"
                id="{{ form_id }}-city"
                name="city"
                autocomplete="shipping address-level2"
                required
                data-geo-city
                disabled
                aria-describedby="{{ form_id }}-city-error"
              >
                <option value="">{{ 'enrollment.shipping.select_province_first' | t }}</option>
              </select>
              <p class="ava-csa__error" id="{{ form_id }}-city-error" data-error-for="city" aria-live="polite" hidden></p>
            </div>

            <div class="ava-csa__field">
              <label class="ava-csa__label" for="{{ form_id }}-district">
                {{ 'confirm_shipping.district' | t }} <span class="ava-csa__req" aria-hidden="true">*</span>
              </label>
              <select
                class="ava-csa__input ava-csa__select"
                id="{{ form_id }}-district"
                name="district"
                autocomplete="shipping address-level3"
                required
                data-geo-district
                disabled
                aria-describedby="{{ form_id }}-district-error"
              >
                <option value="">{{ 'enrollment.shipping.select_city_first' | t }}</option>
              </select>
              <p class="ava-csa__error" id="{{ form_id }}-district-error" data-error-for="district" aria-live="polite" hidden></p>
            </div>
          </div>
        </div>

        <p class="ava-body-sm ava-csa__geo-status" data-geo-status role="status" hidden></p>

        <p class="ava-csa__summary" role="alert" data-csa-summary hidden></p>
        <p class="ava-body-sm ava-csa__status" role="status" data-csa-status hidden></p>

        <div class="ava-csa__actions">
          <button type="submit" class="ava-btn ava-btn--block ava-csa__submit" data-csa-submit disabled>
            {{ button_label }}
          </button>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Confirm shipping address",
  "tag": "section",
  "class": "ava-csa-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Posts a JSON address to the Ava app proxy at <proxy path>/address-confirmed. Only logged-in customers see the form; logged-out visitors see a login link."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the translated default."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "info": "Leave blank to use the translated default."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave blank to use the translated default."
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "default": "/apps/ava-china-address",
      "info": "The store's Ava app proxy prefix and subpath. The form posts to <path>/address-confirmed."
    },
    {
      "type": "url",
      "id": "success_redirect",
      "label": "Success redirect",
      "info": "Leave blank to send the customer to their account page."
    }
  ],
  "presets": [
    { "name": "Confirm shipping address" }
  ]
}
{% endschema %}

{%- comment -%}
  Renders a line icon. Usage:
    {% render 'ava-icon', icon: 'shield', size: 26 %}
  Colour is controlled by the parent's `color` (stroke uses currentColor).
{%- endcomment -%}
{%- liquid
  assign sz = size | default: 26
  assign sw = stroke_width | default: 1.6
-%}
{%- case icon -%}
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" width="{{ sz }}" height="{{ sz }}" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 L19 6 V11 C19 16 12 21 12 21 C12 21 5 16 5 11 V6 Z"/><path d="M9 11.5 L11.2 13.7 L15 9.5"/></svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" width="{{ sz }}" height="{{ sz }}" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7 H15 V16 H3 Z"/><path d="M15 10 H19 L21 13 V16 H15 Z"/><circle cx="7" cy="16" r="1.6"/><circle cx="17.5" cy="16" r="1.6"/></svg>
  {%- when 'clock' -%}
    <svg viewBox="0 0 24 24" width="{{ sz }}" height="{{ sz }}" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7 V12 L15.5 14"/></svg>
  {%- when 'refresh' -%}
    <svg viewBox="0 0 24 24" width="{{ sz }}" height="{{ sz }}" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7 A9 9 0 1 0 21 13"/><path d="M20 4 V8 H16"/></svg>
  {%- when 'precision' -%}
    <svg viewBox="0 0 28 28" width="{{ sz }}" height="{{ sz }}" fill="none" stroke="currentColor" stroke-width="{{ sw }}"><circle cx="14" cy="14" r="9"/><circle cx="14" cy="14" r="4"/><circle cx="14" cy="14" r="1.4" fill="currentColor" stroke="none"/></svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 28 28" width="{{ sz }}" height="{{ sz }}" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linejoin="round"><path d="M7 21 C7 12 13 7 22 7 C22 16 16 21 7 21 Z"/><path d="M11 17 C14 14 17 12 20 11" stroke-linecap="round"/></svg>
  {%- when 'gmp' -%}
    <svg viewBox="0 0 28 28" width="{{ sz }}" height="{{ sz }}" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linejoin="round"><path d="M14 4 L22 7 V13 C22 18 14 23 14 23 C14 23 6 18 6 13 V7 Z"/><path d="M10.5 13.5 L13 16 L17.5 11" stroke-linecap="round"/></svg>
  {%- when 'ingredient' -%}
    <svg viewBox="0 0 24 24" width="{{ sz }}" height="{{ sz }}" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20 C7 20 4 17 4 12 C4 6 9 4 19 4 C19 13 16 20 11 20 Z"/><path d="M11 20 C11 14 13 9 17 7"/></svg>
{%- endcase -%}
